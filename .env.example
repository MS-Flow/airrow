# Arrow runs fully in local mode with no env vars required (ADR-0005).
# Activating integrations later:

# Supabase mode (replaces local JSON store + dev auth)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Claude authoring provider (replaces local deterministic authoring)
# ANTHROPIC_API_KEY=

# GitHub App delivery (enables push-to-GitHub)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
