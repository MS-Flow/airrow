# Airrow runs fully in local mode with no env vars required (ADR-0005).
# Copy to `.env.local` and fill only the integrations you want to activate.

# ── Supabase ────────────────────────────────────────────────────────────────
# Cloud: from Supabase dashboard → Project Settings → API.
# Local dev (`supabase start`): the CLI prints these; the local defaults are stable.
#   URL         → http://127.0.0.1:54321
#   anon key    → the "anon key" line printed by `supabase start` / `supabase status`
#   service key → the "service_role key" line (server-only — never expose to the client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (used by the RLS integration test against local Supabase).
# Cloud: Supabase → Project Settings → Database → Connection string (URI).
# Local default:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# ── Claude authoring provider (replaces local deterministic authoring) ───────
# Without a key, generation is fully deterministic and still delivers a ZIP — the key turns on the
# LLM-authored prose (spec 65), it is not required to run the app.
# From console.anthropic.com → API keys. This is Developer Platform billing, separate from any
# Claude subscription, and the org needs credits before the first call succeeds.
# ANTHROPIC_API_KEY=
# Overrides the authoring model. Defaults to claude-haiku-4-5; set claude-opus-5 to compare quality.
# AIRROW_AUTHORING_MODEL=

# ── GitHub App delivery (enables push-to-GitHub) ────────────────────────────
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=

# ── Auth email sending via Resend (spec 113) ────────────────────────────────
# The hosted project sends through Resend so the verification email comes from Airrow instead of from
# Supabase — configured in the Supabase dashboard, not here (INFRASTRUCTURE_SETUP.md §6).
# You only need this key to test real delivery from your own machine, and doing so means uncommenting
# `[auth.email.smtp]` in supabase/config.toml, which stops mail going to the local inbox and starts
# mailing real addresses. By default local development sends nothing outward.
# RESEND_API_KEY=

# ── Import digests (spec 68) ────────────────────────────────────────────────
# Pepper for hashing the contents of imported files. Never stored in the database: without it a
# leak of import_files could brute-force a short file (an .env line) back out of its digest.
# Format "version:secret", comma-separated. New imports use the highest version; keep retired
# keys here so older imports still diff instead of reading as all-conflicts.
#   generate: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('hex'))"
IMPORT_DIGEST_PEPPERS=1:<random hex>
